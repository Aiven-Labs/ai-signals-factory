{
  "name": "Executor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{$env.CORE_URL}}/executor/queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Factory-Token",
              "value": "={{$env.FACTORY_TOKEN}}"
            }
          ]
        }
      },
      "name": "Core /executor/queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-email",
              "leftValue": "={{ !!$json.email }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json.email.to}}",
        "subject": "={{$json.email.subject}}",
        "emailType": "text",
        "message": "={{$json.email.body}}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Send email (approved)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        720,
        -80
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "VI2EDeCiUwgWaTlZ",
          "name": "AI Signals Gmail"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "sent",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Email went out?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CORE_URL + '/proposals/' + $('Core /executor/queue').item.json.pid + '/email_failed'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Factory-Token",
              "value": "={{$env.FACTORY_TOKEN}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Record failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{$('Core /executor/queue').item.json.chat_id}}",
        "text": "={{ ($('Core /executor/queue').item.json.email ? ($json.id ? 'EMAIL SENT. ' : 'EMAIL FAILED, NOT SENT. ') : '') + $('Core /executor/queue').item.json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Hand over to approver",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Core /executor/queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Core /executor/queue": {
      "main": [
        [
          {
            "node": "Has email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has email?": {
      "main": [
        [
          {
            "node": "Send email (approved)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Hand over to approver",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email (approved)": {
      "main": [
        [
          {
            "node": "Email went out?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email went out?": {
      "main": [
        [
          {
            "node": "Hand over to approver",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record failure": {
      "main": [
        [
          {
            "node": "Hand over to approver",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}