{
  "name": "Telegram outbox",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{$env.CORE_URL}}/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Factory-Token",
              "value": "={{$env.FACTORY_TOKEN}}"
            }
          ]
        }
      },
      "name": "Core /outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "or",
                "conditions": [
                  {
                    "id": "k0",
                    "leftValue": "={{$json.kind}}",
                    "rightValue": "cfp_review",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "talk"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "or",
                "conditions": [
                  {
                    "id": "k0",
                    "leftValue": "={{$json.kind}}",
                    "rightValue": "speaker_invite",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "id": "k1",
                    "leftValue": "={{$json.kind}}",
                    "rightValue": "speaker_followup",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "id": "k2",
                    "leftValue": "={{$json.kind}}",
                    "rightValue": "speaker_thanks",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "id": "k3",
                    "leftValue": "={{$json.kind}}",
                    "rightValue": "speaker_reconfirm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "or",
                "conditions": [
                  {
                    "id": "k0",
                    "leftValue": "={{$json.kind}}",
                    "rightValue": "speaker_reply",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "reply"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "name": "Which card?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "={{$json.text}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Main talk",
                    "additionalFields": {
                      "callback_data": "={{'m:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Lightning talk",
                    "additionalFields": {
                      "callback_data": "={{'l:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "={{'r:' + $json.pid}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send talk proposal",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        -240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "={{$json.text}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Send email",
                    "additionalFields": {
                      "callback_data": "={{'a:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Skip",
                    "additionalFields": {
                      "callback_data": "={{'r:' + $json.pid}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send email approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "={{$json.text}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Confirmed",
                    "additionalFields": {
                      "callback_data": "={{'c:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Declined",
                    "additionalFields": {
                      "callback_data": "={{'d:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "I'll handle",
                    "additionalFields": {
                      "callback_data": "={{'h:' + $json.pid}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send reply card",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "={{$json.text}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approve",
                    "additionalFields": {
                      "callback_data": "={{'a:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "={{'r:' + $json.pid}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send to organiser",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Core /outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Core /outbox": {
      "main": [
        [
          {
            "node": "Which card?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which card?": {
      "main": [
        [
          {
            "node": "Send talk proposal",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send email approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send reply card",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send to organiser",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}