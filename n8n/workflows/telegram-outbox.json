{
  "name": "Telegram outbox",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{$env.CORE_URL}}/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Factory-Token",
              "value": "={{$env.FACTORY_TOKEN}}"
            }
          ]
        }
      },
      "name": "Core /outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-cfp",
              "leftValue": "={{$json.kind}}",
              "rightValue": "cfp_review",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Talk proposal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "={{$json.text}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Main talk",
                    "additionalFields": {
                      "callback_data": "={{'m:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Lightning talk",
                    "additionalFields": {
                      "callback_data": "={{'l:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "={{'r:' + $json.pid}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send talk proposal",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "={{$json.text}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approve",
                    "additionalFields": {
                      "callback_data": "={{'a:' + $json.pid}}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "={{'r:' + $json.pid}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send to organiser",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "__CRED_ID__",
          "name": "AI Signals bot"
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Core /outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Core /outbox": {
      "main": [
        [
          {
            "node": "Talk proposal?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Talk proposal?": {
      "main": [
        [
          {
            "node": "Send talk proposal",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send to organiser",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}